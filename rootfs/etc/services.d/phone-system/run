#!/usr/bin/with-contenv bashio

bashio::log.info "================================================"
bashio::log.info "  Advanced Phone System - Starting..."
bashio::log.info "================================================"

# Load configuration
SIP_ENABLED=$(bashio::config 'sip_trunk.enabled')
SIP_PROVIDER=$(bashio::config 'sip_trunk.provider')
SIP_HOST=$(bashio::config 'sip_trunk.host')
SIP_PORT=$(bashio::config 'sip_trunk.port')
SIP_USER=$(bashio::config 'sip_trunk.username')
SIP_PASS=$(bashio::config 'sip_trunk.password')
SIP_DOMAIN=$(bashio::config 'sip_trunk.from_domain')
SIP_CALLER=$(bashio::config 'sip_trunk.caller_number')

# Get recording system configuration
RECORDING_EXTENSION=$(bashio::config 'recording_extension')
RECORDING_PASSWORD=$(bashio::config 'recording_password')

# Create directories
mkdir -p /var/lib/asterisk/sounds/custom
mkdir -p /var/spool/asterisk/outgoing
mkdir -p /data/recordings
mkdir -p /data/database

# Generate Asterisk sip.conf
bashio::log.info "Generating Asterisk configuration..."

cat > /etc/asterisk/sip.conf <<'EOF'
[general]
context=default
allowoverlap=no
udpbindaddr=0.0.0.0:5060
tcpenable=yes
tcpbindaddr=0.0.0.0
transport=udp,tcp
srvlookup=yes
allowguest=no
alwaysauthreject=yes
nat=force_rport,comedia
externrefresh=10

; Codecs - Order matters!
disallow=all
allow=ulaw
allow=alaw
allow=gsm

; RTP Settings
rtpstart=10000
rtpend=10099
rtptimeout=60
rtpholdtimeout=300

; Security
requirecalltoken=no

; Audio settings
directmedia=no
canreinvite=no

EOF
# Add SIP trunk if enabled
if [ "$SIP_ENABLED" = "true" ]; then
    bashio::log.info "Configuring SIP trunk: ${SIP_PROVIDER}"
    
    # Use from_domain if provided, otherwise use host
    DOMAIN="${SIP_DOMAIN:-$SIP_HOST}"
    
    # Get caller number if provided
    SIP_CALLER=$(bashio::config 'sip_trunk.caller_number')
    
    # Build registration string separately to avoid escape issues
    REG_STRING="${SIP_USER}:${SIP_PASS}@${SIP_HOST}:${SIP_PORT}/${SIP_USER}"
    
    # Write SIP trunk config - removed fromuser line
    {
        echo ""
        echo "; SIP Trunk Registration"
        echo "register => ${REG_STRING}"
        echo ""
        echo "[trunk_main]"
        echo "type=peer"
        echo "host=${SIP_HOST}"
        echo "port=${SIP_PORT}"
        echo "defaultuser=${SIP_USER}"
        echo "secret=${SIP_PASS}"
        echo "fromdomain=${DOMAIN}"
        echo "insecure=port,invite"
        echo "context=inbound"
        echo "dtmfmode=rfc2833"
        echo "canreinvite=no"
        echo "qualify=yes"
        echo "nat=force_rport,comedia"
        echo ""
    } >> /etc/asterisk/sip.conf
    bashio::log.info "✓ SIP trunk configured (user: ${SIP_USER})"
    bashio::log.info "  Registration string: ${REG_STRING}"
else
    bashio::log.warning "SIP trunk disabled - enable in configuration to make calls"
fi

# Add extensions
bashio::log.info "Configuring extensions..."
EXTENSION_COUNT=$(bashio::config 'extensions|length')

for (( i=0; i < EXTENSION_COUNT; i++ )); do
    EXT_NUMBER=$(bashio::config "extensions[${i}].number")
    EXT_NAME=$(bashio::config "extensions[${i}].name")
    EXT_SECRET=$(bashio::config "extensions[${i}].secret")
    EXT_CALLER_ID=$(bashio::config "extensions[${i}].caller_id")
    
    # Use extension-specific caller ID or fall back to trunk default
    if [ -z "$EXT_CALLER_ID" ]; then
        EXT_CALLER_ID="${SIP_CALLER}"
    fi
    
    bashio::log.info "  - Extension ${EXT_NUMBER}: ${EXT_NAME} (Caller ID: ${EXT_CALLER_ID})"
    
    cat >> /etc/asterisk/sip.conf <<EOF

[${EXT_NUMBER}]
type=friend
secret=${EXT_SECRET}
context=internal
host=dynamic
dtmfmode=rfc2833
canreinvite=no
nat=force_rport,comedia
qualify=yes
callgroup=1
pickupgroup=1
callerid="${EXT_NAME}" <${EXT_NUMBER}>
setvar=OUTBOUND_CID=${EXT_CALLER_ID}

EOF
done
bashio::log.info "✓ ${EXTENSION_COUNT} extension(s) configured"
bashio::log.info "Recording extension configured: ${RECORDING_EXTENSION}"

# Add recording extension context to extensions.conf
bashio::log.info "Configuring recording system..."

# Create custom prompt files using Google TTS
mkdir -p /var/lib/asterisk/sounds/custom_prompts

# Generate custom prompts using Google TTS
python3 << 'PYTHON_EOF'
from gtts import gTTS
import os

prompts = {
    "to_record_message": "To record a message, press 1",
    "to_listen": "To listen to messages, press 2",
    "enter_recording_id": "Please enter your recording I D, followed by the pound key",
    "record_your_message": "Please record your message after the beep. When finished, press the pound key",
    "replay_recording": "To replay this recording, press 1",
    "rerecord": "To re-record, press 2",
    "save_recording": "To save this recording, press 3",
    "main_menu": "To go back to the main menu, press star",
    "password": "Please enter your password",
    "auth-thankyou": "Thank you",
    "feature-not-avail-line": "This feature is not available",
    "vm-msgsaved": "Your message has been saved",
    "vm-goodbye": "Goodbye",
    "vm-incorrect": "Incorrect password",
    "listen_by_id": "To listen to a specific recording, press 1",
    "listen_all": "To listen to all recordings, press 2",
    "recording_not_found": "Recording not found. Please try again",
    "all_recordings_played": "All recordings have been played"
}

for name, text in prompts.items():
    tts = gTTS(text=text, lang='en', slow=False)
    tts.save(f'/var/lib/asterisk/sounds/custom_prompts/{name}.mp3')
PYTHON_EOF

# Convert MP3 to WAV, then to ulaw format for Asterisk
for file in /var/lib/asterisk/sounds/custom_prompts/*.mp3; do
    base=$(basename "$file" .mp3)
    sox "$file" -r 8000 -c 1 "/var/lib/asterisk/sounds/custom_prompts/${base}.wav"
    sox "/var/lib/asterisk/sounds/custom_prompts/${base}.wav" -t ul "/var/lib/asterisk/sounds/custom_prompts/${base}.ulaw"
    rm "$file" "/var/lib/asterisk/sounds/custom_prompts/${base}.wav"
done

chown -R asterisk:asterisk /var/lib/asterisk/sounds/custom_prompts

cat >> /etc/asterisk/extensions.conf << 'EOFEXT'

; ============================================
; Recording System with IVR Menu
; ============================================
[record-messages]
exten => s,1,NoOp(=== Recording System Started ===)
 same => n,Answer()
 same => n,Wait(1)
 same => n,Set(AUTH_ATTEMPTS=0)
 ; Password Authentication
 same => n(ask_password),Background(custom_prompts/password)
 same => n,Read(PASSWORD,,4,,10)
 same => n,NoOp(Password entered: ${PASSWORD})
 same => n,GotoIf($["${PASSWORD}" = ""]?ask_password)
 same => n,GotoIf($["${PASSWORD}" = "RECORDING_PASSWORD_PLACEHOLDER"]?authenticated:wrong_password)
 ; Wrong password handling
 same => n(wrong_password),Set(AUTH_ATTEMPTS=$[${AUTH_ATTEMPTS} + 1])
 same => n,Playback(vm-incorrect)
 same => n,GotoIf($[${AUTH_ATTEMPTS} >= 3]?auth_failed:ask_password)
 same => n(auth_failed),Playback(vm-goodbye)
 same => n,Hangup()
 ; Authenticated - Show Main Menu
 same => n(authenticated),Playback(auth-thankyou)
 same => n,Wait(1)
 ; Main Menu
 same => n(main_menu),Background(custom_prompts/to_record_message)
 same => n,Background(custom_prompts/to_listen)
 same => n,WaitExten(5)
 same => n,Goto(main_menu)

; Extension 1: Record new message
exten => 1,1,NoOp(=== Starting Recording ===)
 same => n,Background(custom_prompts/enter_recording_id)
 same => n,Read(RECORDING_ID,,10,,3,10)
 same => n,NoOp(Recording ID entered: ${RECORDING_ID})
 same => n,GotoIf($["${RECORDING_ID}" = ""]?1,1)
 same => n,Background(custom_prompts/record_your_message)
 same => n,Wait(2)
 same => n,Set(TIMESTAMP=${STRFTIME(${EPOCH},,%Y%m%d_%H%M%S)})
 same => n,Set(FILENAME=phone_${RECORDING_ID}_${TIMESTAMP})
 same => n,Set(FULLPATH=/var/lib/asterisk/sounds/custom/${FILENAME})
 same => n,NoOp(About to record to: ${FULLPATH}.wav)
 same => n,Playback(beep)
 same => n,Set(TIMEOUT(digit)=30)
 same => n,Set(TIMEOUT(response)=30)
 same => n,Record(${FULLPATH}.wav,,300,nsk)
 same => n,NoOp(Recording finished - status: ${RECORD_STATUS})
 same => n,System(ls -lh ${FULLPATH}.wav)
 same => n,Wait(1)
 same => n,NoOp(Recording complete: ${FULLPATH}.wav)
 same => n,Goto(review,s,1)

; Extension 2: Listen to messages - Main Playback Menu
exten => 2,1,NoOp(=== Listen to Messages Menu ===)
 same => n,Background(custom_prompts/listen_by_id)
 same => n,Background(custom_prompts/listen_all)
 same => n,WaitExten(10)
 same => n,Goto(2,1)

; Timeout handler
exten => t,1,NoOp(=== Timeout ===)
 same => n,Goto(s,main_menu)

; Invalid option
exten => i,1,Playback(option)
 same => n,Playback(is-invalid)
 same => n,Goto(s,main_menu)

; ============================================
; Review Menu Context
; ============================================
[review]
exten => s,1,NoOp(=== Review Menu ===)
 same => n,Background(custom_prompts/replay_recording)
 same => n,Background(custom_prompts/rerecord)
 same => n,Background(custom_prompts/save_recording)
 same => n,Background(custom_prompts/main_menu)
 same => n,WaitExten(10)
 same => n,Goto(s,1)

; Option 1: Replay recording
exten => 1,1,NoOp(=== Playing Recording ===)
 same => n,Playback(${FULLPATH})
 same => n,Wait(1)
 same => n,Goto(s,1)

; Option 2: Re-record
exten => 2,1,NoOp(=== Re-recording ===)
 same => n,System(rm -f ${FULLPATH}.wav)
 same => n,Goto(record-messages,1,1)

; Option 3: Save recording
exten => 3,1,NoOp(=== Saving Recording ===)
 same => n,System(curl -X POST "http://localhost:8088/api/recordings/register?filename=${FILENAME}.wav&recording_id=${RECORDING_ID}" 2>/dev/null)
 same => n,Playback(vm-msgsaved)
 same => n,Wait(1)
 same => n,Playback(vm-goodbye)
 same => n,Hangup()

; Option *: Back to main menu
exten => *,1,NoOp(=== Back to Main Menu ===)
 same => n,Goto(record-messages,s,main_menu)

; Timeout
exten => t,1,Goto(s,1)

; Invalid
exten => i,1,Playback(option)
 same => n,Playback(is-invalid)
 same => n,Goto(s,1)

EOFEXT

cat >> /etc/asterisk/extensions.conf << 'EOFEXT2'

; ============================================
; Playback Menu Context
; ============================================
[playback-menu]
; Option 1: Listen by Recording ID
exten => 1,1,NoOp(=== Listen by Recording ID ===)
 same => n(ask_id),Background(custom_prompts/enter_recording_id)
 same => n,Read(PLAYBACK_ID,,10,,3,10)
 same => n,NoOp(User wants to hear recording ID: ${PLAYBACK_ID})
 same => n,GotoIf($["${PLAYBACK_ID}" = ""]?ask_id)
 same => n,System(ls /var/lib/asterisk/sounds/custom/phone_${PLAYBACK_ID}_*.wav 2>/dev/null | head -1 > /tmp/play_file_${UNIQUEID}.txt)
 same => n,Set(PLAY_FILE=${FILE(/tmp/play_file_${UNIQUEID}.txt)})
 same => n,System(rm -f /tmp/play_file_${UNIQUEID}.txt)
 same => n,GotoIf($["${PLAY_FILE}" = ""]?no_recording)
 same => n,System(basename ${PLAY_FILE} .wav > /tmp/play_basename_${UNIQUEID}.txt)
 same => n,Set(PLAY_BASE=${FILE(/tmp/play_basename_${UNIQUEID}.txt)})
 same => n,System(rm -f /tmp/play_basename_${UNIQUEID}.txt)
 same => n,Playback(/var/lib/asterisk/sounds/custom/${PLAY_BASE})
 same => n,Wait(1)
 same => n,Playback(beep)
 same => n,Goto(record-messages,s,main_menu)
 same => n(no_recording),Playback(custom_prompts/recording_not_found)
 same => n,Wait(1)
 same => n,Goto(ask_id)

; Option 2: Listen to all recordings (newest to oldest)
exten => 2,1,NoOp(=== Listen to All Recordings ===)
 same => n,System(ls -t /var/lib/asterisk/sounds/custom/phone_*.wav 2>/dev/null > /tmp/all_recordings_${UNIQUEID}.txt)
 same => n,Set(RECORDING_LIST=/tmp/all_recordings_${UNIQUEID}.txt)
 same => n,Set(CURRENT_LINE=1)
 same => n,Goto(play_next)
 same => n(play_next),NoOp(Playing recording line ${CURRENT_LINE})
 same => n,System(sed -n '${CURRENT_LINE}p' ${RECORDING_LIST} > /tmp/current_rec_${UNIQUEID}.txt)
 same => n,Set(CURRENT_FILE=${FILE(/tmp/current_rec_${UNIQUEID}.txt)})
 same => n,System(rm -f /tmp/current_rec_${UNIQUEID}.txt)
 same => n,GotoIf($["${CURRENT_FILE}" = ""]?all_done)
 same => n,System(basename ${CURRENT_FILE} .wav > /tmp/current_base_${UNIQUEID}.txt)
 same => n,Set(CURRENT_BASE=${FILE(/tmp/current_base_${UNIQUEID}.txt)})
 same => n,System(rm -f /tmp/current_base_${UNIQUEID}.txt)
 same => n,NoOp(Playing: ${CURRENT_BASE})
 same => n,Background(/var/lib/asterisk/sounds/custom/${CURRENT_BASE})
 same => n,WaitExten(2)
 same => n,Playback(beep)
 same => n,Set(CURRENT_LINE=$[${CURRENT_LINE} + 1])
 same => n,Goto(play_next)
 same => n(all_done),System(rm -f ${RECORDING_LIST})
 same => n,Playback(custom_prompts/all_recordings_played)
 same => n,Wait(1)
 same => n,Goto(record-messages,s,main_menu)

; Star key: Back to main menu (during playback)
exten => *,1,NoOp(=== Returning to Main Menu ===)
 same => n,System(rm -f /tmp/all_recordings_${UNIQUEID}.txt /tmp/current_rec_${UNIQUEID}.txt /tmp/current_base_${UNIQUEID}.txt)
 same => n,Goto(record-messages,s,main_menu)

; Timeout handler
exten => t,1,NoOp(=== Playback Timeout ===)
 same => n,Set(CURRENT_LINE=$[${CURRENT_LINE} + 1])
 same => n,Goto(2,play_next)

; Invalid option
exten => i,1,NoOp(=== Invalid Option in Playback ===)
 same => n,Playback(option)
 same => n,Playback(is-invalid)
 same => n,Goto(record-messages,2,1)

EOFEXT2

# Replace password placeholder with actual password
sed -i "s/RECORDING_PASSWORD_PLACEHOLDER/${RECORDING_PASSWORD}/g" /etc/asterisk/extensions.conf

bashio::log.info "✓ Recording system with high-quality TTS prompts configured on extension ${RECORDING_EXTENSION}"

# Add internal context with outbound calling
bashio::log.info "Configuring internal extensions and outbound calling..."
cat >> /etc/asterisk/extensions.conf << EOF

; ============================================
; Internal Context - Extensions and Outbound
; ============================================
[internal]
; Internal extension-to-extension calls
exten => _1XX,1,NoOp(=== Internal Call to \${EXTEN} ===)
 same => n,Dial(SIP/\${EXTEN},30,tr)
 same => n,Hangup()

; Recording system extension
exten => ${RECORDING_EXTENSION},1,NoOp(=== Calling Recording System ===)
 same => n,Goto(record-messages,s,1)

; 10-digit US/Canada dialing - auto-prepend 1
exten => _NXXNXXXXXX,1,NoOp(=== Outbound Call to 1\${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/1\${EXTEN},120,tT)
 same => n,Hangup()

; 11-digit US/Canada dialing (1-NPA-NXX-XXXX)
exten => _1NXXNXXXXXX,1,NoOp(=== Outbound Call to \${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/\${EXTEN},120,tT)
 same => n,Hangup()

; International calls (011 + country code + number)
exten => _011.,1,NoOp(=== International Call to \${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/\${EXTEN},120,tT)
 same => n,Hangup()

; Toll-free numbers (1-8XX-XXX-XXXX)
exten => _1800NXXXXXX,1,NoOp(=== Toll-Free Call to \${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/\${EXTEN},120,tT)
 same => n,Hangup()

exten => _1888NXXXXXX,1,NoOp(=== Toll-Free Call to \${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/\${EXTEN},120,tT)
 same => n,Hangup()

exten => _1877NXXXXXX,1,NoOp(=== Toll-Free Call to \${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/\${EXTEN},120,tT)
 same => n,Hangup()

exten => _1866NXXXXXX,1,NoOp(=== Toll-Free Call to \${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/\${EXTEN},120,tT)
 same => n,Hangup()

exten => _1855NXXXXXX,1,NoOp(=== Toll-Free Call to \${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/\${EXTEN},120,tT)
 same => n,Hangup()

exten => _1844NXXXXXX,1,NoOp(=== Toll-Free Call to \${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/\${EXTEN},120,tT)
 same => n,Hangup()

exten => _1833NXXXXXX,1,NoOp(=== Toll-Free Call to \${EXTEN} ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/\${EXTEN},120,tT)
 same => n,Hangup()

; Emergency calls (911)
exten => 911,1,NoOp(=== Emergency Call to 911 ===)
 same => n,Set(CALLERID(num)=\${OUTBOUND_CID})
 same => n,Dial(SIP/trunk_main/911,120,tT)
 same => n,Hangup()
EOF

bashio::log.info "✓ Internal context with outbound calling configured"

# Set permissions

# Set permissions
chown -R asterisk:asterisk /etc/asterisk
chown -R asterisk:asterisk /var/lib/asterisk
chown -R asterisk:asterisk /var/spool/asterisk

# Kill any existing Asterisk processes
bashio::log.info "Cleaning up any existing Asterisk processes..."
pkill -9 asterisk 2>/dev/null || true
rm -f /var/run/asterisk/asterisk.ctl 2>/dev/null || true
sleep 2

# Start Asterisk
bashio::log.info "Starting Asterisk PBX..."
asterisk -f &
ASTERISK_PID=$!

# Wait for Asterisk to initialize
sleep 5

# Check Asterisk status (BusyBox compatible)
if kill -0 $ASTERISK_PID 2>/dev/null; then
    bashio::log.info "✓ Asterisk PBX started successfully"
else
    bashio::log.error "✗ Asterisk failed to start!"
    exit 1
fi

# Start API service
bashio::log.info "Starting API service..."
cd /app
python3 api_service.py &
API_PID=$!

# Wait for API to start
sleep 3

# Check API status (BusyBox compatible)
if kill -0 $API_PID 2>/dev/null; then
    bashio::log.info "✓ API service started successfully"
else
    bashio::log.error "✗ API service failed to start!"
    kill $ASTERISK_PID 2>/dev/null
    exit 1
fi

bashio::log.info "================================================"
bashio::log.info "  Advanced Phone System is READY!"
bashio::log.info "  Web UI: http://homeassistant.local:8088"
bashio::log.info "================================================"

# Monitor both processes (BusyBox compatible)
while true; do
    if ! kill -0 $ASTERISK_PID 2>/dev/null; then
        bashio::log.error "Asterisk process died - restarting addon..."
        kill $API_PID 2>/dev/null
        exit 1
    fi
    
    if ! kill -0 $API_PID 2>/dev/null; then
        bashio::log.error "API service died - restarting addon..."
        kill $ASTERISK_PID 2>/dev/null
        exit 1
    fi
    
    sleep 10
done
